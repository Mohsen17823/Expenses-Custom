<odoo>
    <record id="recall_wizard_view" model="ir.ui.view">
        <field name="name">Recall</field>
        <field name="model">hr.expense.recall.wizard</field>
        <field name="arch" type="xml">
           <form string="Recall Reason" delete="False">
                <separator string="Reason to Reject Expense"/>
                <group>
                    <field name="sheet_id" invisible="1" can_create="True" can_write="True"/>
                    <field name="reason_recall" class="w-100" field_id="reason_0"/>
                </group>
                <footer>
                    <button string="Recall" type="object" name="action_recall" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="recall_wizard_action" model="ir.actions.act_window">
        <field name="name">Recall</field>
        <field name="res_model">hr.expense.recall.wizard</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>
</odoo>