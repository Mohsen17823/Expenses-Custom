<odoo>
    <record id="reject_wizard_view_inherit" model="ir.ui.view">
        <field name="name">view reject wizard form</field>
        <field name="model">hr.expense.refuse.wizard</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_refuse_wizard_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="string">Reject Reason</attribute>
            </xpath>
            <xpath expr="//separator" position="attributes">
                <attribute name="string">Reason to Reject Expense</attribute>
            </xpath>
            <xpath expr="//button[@name='action_refuse']" position="attributes">
                <attribute name="string">Reject</attribute>
            </xpath>
        </field>
    </record>
</odoo>