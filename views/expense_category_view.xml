<odoo>
    <record id="expense_category_inherit_view" model="ir.ui.view">
        <field name="name">view expense category form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="hr_expense.product_product_expense_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[position()=2]" position="inside">
                <field name="hr_approval"/>
                <field name="expense_limit"/>
                <field name="amount" invisible="not expense_limit" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="type_approval"/>
            </xpath>
        </field>
    </record>
</odoo>